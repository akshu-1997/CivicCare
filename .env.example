# Copy to .env and fill in. Never commit .env.
# PostgreSQL connection string (Supabase: Project Settings > Database > Connection string)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/civiccare
# Set to true for hosted databases that require SSL (Supabase, Render, Neon)
DATABASE_SSL=false
# Admin dashboard password (use a long, unique one)
ADMIN_PASSWORD=change-me-to-a-long-password
# Random string used to sign admin sessions. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-64-char-string
PORT=3000
